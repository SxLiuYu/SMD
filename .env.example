# SMD 配置示例
# 复制此文件为 .env 并填入真实值

# Finna (扁担云) API Keys
FINNA_PRO_API_KEY=your_finna_pro_api_key_here
FINNA_FLASH_API_KEY=your_finna_flash_api_key_here

# Agnes AI API Key
AGNES_API_KEY=your_agnes_api_key_here

# Tavily Search API Key
TAVILY_API_KEY=your_tavily_api_key_here

# DeepSeek Search API Key (可选)
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# SearXNG URL (本地搜索引擎，可选)
SEARXNG_URL=http://localhost:8080
